{
  "annotations": { "list": [] },
  "description": "E-Commerce Application HTTP Metrics",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "title": "Overview", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 100 }] }, "unit": "reqps" } },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 }, "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Total Request Rate", "type": "stat",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=~\"$service\"}[$__rate_interval]))", "legendFormat": "req/s" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }, "unit": "percent" } },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 }, "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Error Rate (5xx)", "type": "stat",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=~\"$service\", http_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_duration_milliseconds_count{job=~\"$service\"}[$__rate_interval])) * 100", "legendFormat": "error %" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] }, "unit": "ms" } },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 }, "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Avg Latency (P50)", "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.50, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le))", "legendFormat": "p50" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 3000 }] }, "unit": "ms" } },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 }, "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "P99 Latency", "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le))", "legendFormat": "p99" }]
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "id": 101, "title": "Request Rate", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "none" } }, "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "id": 5,
      "title": "Request Rate by Service", "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=~\"$service\"}[$__rate_interval])) by (job)", "legendFormat": "{{job}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }, "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "id": 6,
      "title": "Request Rate by Status Code", "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=~\"$service\"}[$__rate_interval])) by (http_status_code)", "legendFormat": "HTTP {{http_status_code}}" }]
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }, "id": 102, "title": "Latency", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 }, "id": 7,
      "title": "Latency P95 by Service", "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le, job))", "legendFormat": "{{job}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 }, "id": 8,
      "title": "Latency Percentiles", "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.90, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le))", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le))", "legendFormat": "p99" }
      ]
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }, "id": 103, "title": "Per-Service Breakdown", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 }, "id": 9,
      "title": "API Gateway", "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"api-gateway\"}[$__rate_interval])) by (http_status_code)", "legendFormat": "{{http_status_code}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 }, "id": 10,
      "title": "Product Service", "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"product-service\"}[$__rate_interval])) by (http_status_code)", "legendFormat": "{{http_status_code}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 }, "id": 11,
      "title": "Order Service", "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"order-service\"}[$__rate_interval])) by (http_status_code)", "legendFormat": "{{http_status_code}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 34 }, "id": 12,
      "title": "Payment Service", "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"payment-service\"}[$__rate_interval])) by (http_status_code)", "legendFormat": "{{http_status_code}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 34 }, "id": 13,
      "title": "User Service", "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"user-service\"}[$__rate_interval])) by (http_status_code)", "legendFormat": "{{http_status_code}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "ms" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 }, "id": 14,
      "title": "Latency P95 per Service", "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le, job))", "legendFormat": "{{job}}" }]
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 }, "id": 104, "title": "Throughput", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "Bps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 }, "id": 15,
      "title": "Request Size (bytes/s)", "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_request_size_bytes_total{job=~\"$service\"}[$__rate_interval])) by (job)", "legendFormat": "{{job}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "Bps" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 }, "id": 16,
      "title": "Response Size (bytes/s)", "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_response_size_bytes_total{job=~\"$service\"}[$__rate_interval])) by (job)", "legendFormat": "{{job}}" }]
    }
  ],
  "schemaVersion": 39,
  "tags": ["ecommerce", "application", "http"],
  "templating": { "list": [
    { "current": {}, "hide": 0, "includeAll": false, "label": "Datasource", "multi": false, "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "type": "datasource" },
    { "current": { "selected": true, "text": "All", "value": "$__all" }, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "definition": "label_values(http_server_duration_milliseconds_count, job)", "hide": 0, "includeAll": true, "label": "Service", "multi": true, "name": "service", "query": "label_values(http_server_duration_milliseconds_count, job)", "refresh": 2, "sort": 1, "type": "query" }
  ] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "E-Commerce App - Application Metrics",
  "uid": "ecommerce-app-metrics",
  "version": 1
}
