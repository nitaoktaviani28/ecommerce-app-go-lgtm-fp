{
  "annotations": { "list": [] },
  "description": "E-Commerce Application HTTP Metrics",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "title": "Overview", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 100 }] }, "unit": "reqps" } },
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 1 }, "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Total Request Rate", "type": "stat",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=~\"$service\", http_route!~\"/health|/ready|/live|/metrics\"}[$__rate_interval]))", "legendFormat": "req/s" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] }, "unit": "ms" } },
      "gridPos": { "h": 6, "w": 5, "x": 5, "y": 1 }, "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "P50 Latency", "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.50, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le))", "legendFormat": "p50" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 700 }, { "color": "red", "value": 1500 }] }, "unit": "ms" } },
      "gridPos": { "h": 6, "w": 5, "x": 10, "y": 1 }, "id": 17,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "P90 Latency", "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.90, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le))", "legendFormat": "p90" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 2000 }] }, "unit": "ms" } },
      "gridPos": { "h": 6, "w": 5, "x": 15, "y": 1 }, "id": 18,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "P95 Latency", "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le))", "legendFormat": "p95" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 3000 }] }, "unit": "ms" } },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 1 }, "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "P99 Latency", "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le))", "legendFormat": "p99" }]
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "id": 101, "title": "Request Rate by Service", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] }, "unit": "reqps" } },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 8 }, "id": 19,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "API Gateway", "type": "stat",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"api-gateway\", http_route!~\"/health|/ready|/live|/metrics\"}[$__rate_interval]))", "legendFormat": "req/s" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] }, "unit": "reqps" } },
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 8 }, "id": 20,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Product Service", "type": "stat",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"product-service\", http_route!~\"/health|/ready|/live|/metrics\"}[$__rate_interval]))", "legendFormat": "req/s" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] }, "unit": "reqps" } },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 8 }, "id": 21,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Order Service", "type": "stat",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"order-service\", http_route!~\"/health|/ready|/live|/metrics\"}[$__rate_interval]))", "legendFormat": "req/s" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] }, "unit": "reqps" } },
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 8 }, "id": 22,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Payment Service", "type": "stat",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"payment-service\", http_route!~\"/health|/ready|/live|/metrics\"}[$__rate_interval]))", "legendFormat": "req/s" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] }, "unit": "reqps" } },
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 8 }, "id": 23,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "User Service", "type": "stat",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"user-service\", http_route!~\"/health|/ready|/live|/metrics\"}[$__rate_interval]))", "legendFormat": "req/s" }]
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "description": "Frontend tidak punya metric Prometheus http_server_duration_milliseconds_count (SPA, bukan server). Dihitung dari rate log request yang dikirim Faro RUM ke Loki.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] }, "unit": "reqps" } },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 8 }, "id": 24,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Frontend", "type": "stat",
      "targets": [{ "expr": "sum(rate({source=\"frontend\"} | logfmt | kind=\"event\" | event_name=~\"faro.tracing.fetch|faro.tracing.xhr\" [$__rate_interval]))", "legendFormat": "req/s" }]
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "id": 200, "title": "Error & Success Analysis", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Persentase request yang berakhir error, mencakup 4xx (client) dan 5xx (server), bukan cuma 500.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }, "unit": "percent" } },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 15 }, "id": 201,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Error Rate (4xx + 5xx)", "type": "stat",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=~\"$service\", http_status_code=~\"4..|5..\"}[$__rate_interval])) / sum(rate(http_server_duration_milliseconds_count{job=~\"$service\"}[$__rate_interval])) * 100", "legendFormat": "error %" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Persentase request yang sukses (status 2xx).",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99 }] }, "unit": "percent" } },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 15 }, "id": 202,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Success Rate (2xx)", "type": "stat",
      "targets": [{ "expr": "sum(rate(http_server_duration_milliseconds_count{job=~\"$service\", http_status_code=~\"2..\"}[$__rate_interval])) / sum(rate(http_server_duration_milliseconds_count{job=~\"$service\"}[$__rate_interval])) * 100", "legendFormat": "success %" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Ranking success rate (2xx) per service. Bar paling panjang = service paling banyak sukses.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99 }] }, "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 15 }, "id": 203,
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true },
      "title": "Success Rate by Service", "type": "bargauge",
      "targets": [{ "expr": "sum by (job) (rate(http_server_duration_milliseconds_count{job=~\"$service\", http_status_code=~\"2..\"}[$__rate_interval])) / sum by (job) (rate(http_server_duration_milliseconds_count{job=~\"$service\"}[$__rate_interval])) * 100", "legendFormat": "{{job}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Ranking error rate (4xx+5xx) per service. Bar paling panjang = service paling banyak error.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }, "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 15 }, "id": 204,
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true },
      "title": "Error Rate by Service", "type": "bargauge",
      "targets": [{ "expr": "sum by (job) (rate(http_server_duration_milliseconds_count{job=~\"$service\", http_status_code=~\"4..|5..\"}[$__rate_interval])) / sum by (job) (rate(http_server_duration_milliseconds_count{job=~\"$service\"}[$__rate_interval])) * 100", "legendFormat": "{{job}}" }]
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "description": "Log request yang kena error 500, per container/service, ambil dari Loki (butuh middleware Go yang sudah mencatat status=... di log RESPONSE).",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 }, "id": 205,
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "title": "Error Logs (500) by Service", "type": "logs",
      "targets": [{ "expr": "{namespace=\"ecommerce\", container=~\"$service\"} | logfmt | status=~\"5..\"", "legendFormat": "" }]
    }
  ],
  "schemaVersion": 39,
  "tags": ["ecommerce", "application", "http"],
  "templating": { "list": [
    { "current": {}, "hide": 0, "includeAll": false, "label": "Datasource", "multi": false, "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "type": "datasource" },
    { "current": {}, "hide": 0, "includeAll": false, "label": "Loki Datasource", "multi": false, "name": "datasource_loki", "options": [], "query": "loki", "refresh": 1, "type": "datasource" },
    { "current": { "selected": true, "text": "All", "value": "$__all" }, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "definition": "label_values(http_server_duration_milliseconds_count, job)", "hide": 0, "includeAll": true, "label": "Service", "multi": true, "name": "service", "query": "label_values(http_server_duration_milliseconds_count, job)", "refresh": 2, "sort": 1, "type": "query" }
  ] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "E-Commerce App - Application Metrics",
  "uid": "ecommerce-app-metrics",
  "version": 1
}
